---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contacto | Portafolio Isaac Paucar">
  <div class="max-w-4xl mx-auto pt-16 pb-20 px-4 md:pt-24">
    
    <!-- Encabezado -->
    <header class="mb-16">
      <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight mb-6 leading-tight">
        Hablemos
      </h1>
      <p class="text-xl md:text-2xl font-medium opacity-90 max-w-2xl leading-relaxed">
        Estoy buscando oportunidades como desarrollador full-stack. Si mi perfil encaja con lo que buscas, o simplemente quieres conversar sobre algún proyecto, escríbeme.
      </p>
    </header>

    <!-- Contenedor de las Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <!-- 1. Tarjeta de Email -->
      <a href="mailto:isaipaucar@gmail.com" class="flex flex-col p-6 sm:p-8 rounded-xl border border-[var(--text-color)]/20 bg-[var(--text-color)]/5 hover:border-[var(--accent-color)]/50 transition-all duration-300 group">
        <div class="w-12 h-12 flex items-center justify-center rounded-lg bg-[var(--text-color)]/10 text-[var(--text-color)] group-hover:text-[var(--accent-color)] group-hover:bg-[var(--accent-color)]/10 transition-colors mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
        </div>
        <span class="font-mono uppercase tracking-wider text-sm font-semibold mb-1 opacity-80 text-[var(--text-color)] group-hover:text-[var(--accent-color)] transition-colors">Email</span>
        <span class="text-base opacity-80 break-all group-hover:text-[var(--accent-color)] transition-colors">isaipaucar@gmail.com</span>
      </a>

      <!-- 2. Tarjeta de GitHub -->
      <a href="https://github.com/Isaac-9026" target="_blank" rel="noopener noreferrer" class="flex flex-col p-6 sm:p-8 rounded-xl border border-[var(--text-color)]/20 bg-[var(--text-color)]/5 hover:border-[var(--accent-color)]/50 transition-all duration-300 group">
        <div class="w-12 h-12 flex items-center justify-center rounded-lg bg-[var(--text-color)]/10 text-[var(--text-color)] group-hover:text-[var(--accent-color)] group-hover:bg-[var(--accent-color)]/10 transition-colors mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.02c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A4.8 4.8 0 0 0 8 18v4"></path>
          </svg>
        </div>
        <span class="font-mono uppercase tracking-wider text-sm font-semibold mb-1 opacity-80 text-[var(--text-color)] group-hover:text-[var(--accent-color)] transition-colors">GitHub</span>
        <span class="text-base opacity-80 group-hover:text-[var(--accent-color)] transition-colors">github.com/Isaac-9026</span>
      </a>

      <!-- 3. Tarjeta de LinkedIn -->
      <a href="https://linkedin.com/in/isaac-paucar" target="_blank" rel="noopener noreferrer" class="flex flex-col p-6 sm:p-8 rounded-xl border border-[var(--text-color)]/20 bg-[var(--text-color)]/5 hover:border-[var(--accent-color)]/50 transition-all duration-300 group">
        <div class="w-12 h-12 flex items-center justify-center rounded-lg bg-[var(--text-color)]/10 text-[var(--text-color)] group-hover:text-[var(--accent-color)] group-hover:bg-[var(--accent-color)]/10 transition-colors mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
            <rect x="2" y="9" width="4" height="12"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
        </div>
        <span class="font-mono uppercase tracking-wider text-sm font-semibold mb-1 opacity-80 text-[var(--text-color)] group-hover:text-[var(--accent-color)] transition-colors">LinkedIn</span>
        <span class="text-base opacity-80 group-hover:text-[var(--accent-color)] transition-colors text-ellipsis overflow-hidden whitespace-nowrap">linkedin.com/in/isaac-paucar</span>
      </a>

    </div>
  </div>
</Layout>