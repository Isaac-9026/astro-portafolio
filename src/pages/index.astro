---
import Layout from '../layouts/Layout.astro';
import SkillBadge from '../components/SkillBadge.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
---

<Layout title="Inicio | Portafolio Isaac Paucar">
  <section class="pt-16 pb-12 md:pt-24 md:pb-20 max-w-3xl">
    <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight mb-6 leading-tight">
      Hola, soy <span class="text-[var(--accent-color)] block sm:inline">Isai Isaac</span>
    </h1>
    
    <p class="text-xl md:text-2xl font-medium mb-4 opacity-90">
      Desarrollador Full-Stack trabajando con JavaScript/TypeScript, Java y Python.
    </p>
    
    <p class="text-lg mb-10 leading-relaxed opacity-80">
      Construyo soluciones robustas y eficientes enfocadas en resolver problemas concretos de negocio, aportando valor técnico en cada etapa del desarrollo de software.
    </p>
    
    <div class="flex flex-col sm:flex-row gap-4 mb-20">
      <a href="/proyectos" class="bg-[var(--accent-color)] text-white hover:opacity-90 font-semibold px-8 py-3 rounded-lg text-center transition-opacity">
        Ver proyectos
      </a>
      <a href="/cv-isaac-paucar.pdf" download target="_blank" rel="noopener noreferrer" class="bg-transparent hover:bg-[var(--text-color)]/10 text-[var(--text-color)] font-semibold px-8 py-3 rounded-lg text-center transition-colors border border-[var(--text-color)]/30">
        Descargar CV
      </a>
    </div>

    <div class="border-t border-[var(--text-color)]/20 pt-16">
      <h2 class="text-2xl font-bold mb-4 opacity-100">Sobre mí</h2>
      <p class="text-lg leading-relaxed opacity-80">
        Estudiante de Ingeniería de Software, con experiencia trabajando en proyectos reales de desarrollo web y análisis de datos. Me interesa construir software que resuelva problemas concretos, con atención tanto al código como a la experiencia de quien lo usa.
      </p>
    </div>

    <div class="border-t border-[var(--text-color)]/20 pt-16 mt-16">
      <h2 class="text-2xl font-bold mb-8 opacity-100">Stack técnico</h2>
      
      <div class="flex flex-col gap-8">
        <div>
          <h3 class="text-lg font-semibold mb-4 opacity-90">Frontend</h3>
          <div class="flex flex-wrap gap-3">
            <SkillBadge name="HTML" />
            <SkillBadge name="CSS" />
            <SkillBadge name="Tailwind CSS" />
            <SkillBadge name="JavaScript" />
            <SkillBadge name="TypeScript" />
            <SkillBadge name="React" />
            <SkillBadge name="Next.js" />
          </div>
        </div>

        <div>
          <h3 class="text-lg font-semibold mb-4 opacity-90">Backend</h3>
          <div class="flex flex-wrap gap-3">
            <SkillBadge name="Node.js" />
            <SkillBadge name="Express" />
            <SkillBadge name="Spring Boot" />
            <SkillBadge name="FastAPI" />
            <SkillBadge name="PHP" />
          </div>
        </div>

        <div>
          <h3 class="text-lg font-semibold mb-4 opacity-90">Bases de datos</h3>
          <div class="flex flex-wrap gap-3">
            <SkillBadge name="PostgreSQL" />
            <SkillBadge name="MySQL" />
            <SkillBadge name="MariaDB" />
            <SkillBadge name="NoSQL" />
          </div>
        </div>

        <div>
          <h3 class="text-lg font-semibold mb-4 opacity-90">DevOps y herramientas</h3>
          <div class="flex flex-wrap gap-3">
            <SkillBadge name="Docker" />
            <SkillBadge name="Git" />
            <SkillBadge name="GitHub" />
          </div>
        </div>
      </div>
    </div>

    <div class="border-t border-[var(--text-color)]/20 pt-16 mt-16">
      <h2 class="text-2xl font-bold mb-8 opacity-100">Experiencia</h2>
      
      <ol class="relative border-s border-[var(--text-color)]/20 ml-3 md:ml-4">
        <ExperienceItem 
          role="Desarrollador de Software"
          company="ASESCON"
          period="Febrero 2026 – Actualidad"
          description="Desarrollo de sistema web para procesamiento y análisis de datos contables. Manejo de archivos Excel con grandes volúmenes de información, generación de reportes y estadísticas, implementación de funcionalidades de filtrado, almacenamiento y descarga de datos."
          stack={['React', 'FastAPI']}
          isCurrent={true}
        />
        <ExperienceItem 
          role="Asistente de Sistemas"
          company="CompuServic"
          period="Julio 2025 – Diciembre 2025"
          description="Participación en diseño y mantenimiento de páginas web y sistemas internos, organización y actualización de contenido digital, gestión de datos y reportes estadísticos, soporte técnico y mantenimiento preventivo de equipos."
        />
      </ol>
    </div>
  </section>
</Layout>
