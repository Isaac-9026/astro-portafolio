---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SkillBadge from '../components/SkillBadge.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactSection from '../components/ContactSection.astro';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter(p => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Inicio | Portafolio Isaac Paucar">
  <!-- Glow del Hero -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-2xl h-[500px] bg-[var(--accent-color)]/15 blur-[120px] rounded-full pointer-events-none -z-10"></div>
  
  <div class="max-w-3xl mx-auto">
    <section class="pt-16 pb-12 md:pt-24 md:pb-20">
    <h1 class="animate-on-scroll text-5xl md:text-7xl font-extrabold tracking-tighter mb-6 leading-tight">
      Hola, soy <span class="text-[var(--accent-color)] block sm:inline">Isai Isaac</span>
    </h1>
    
    <p class="animate-on-scroll text-xl md:text-2xl font-medium mb-4 opacity-90">
      Desarrollador Full-Stack trabajando con JavaScript/TypeScript, Java y Python.
    </p>
    
    <p class="animate-on-scroll text-lg mb-10 leading-relaxed opacity-80">
      Construyo soluciones robustas y eficientes enfocadas en resolver problemas concretos de negocio, aportando valor técnico en cada etapa del desarrollo de software.
    </p>
    
    <div class="animate-on-scroll flex flex-col sm:flex-row gap-4 mb-20">
      <a href="/proyectos" class="bg-[var(--accent-color)] text-white hover:opacity-90 font-semibold px-8 py-3 rounded-lg text-center transition-all duration-300">
        Ver proyectos
      </a>
      <a href="/cv-isaac-paucar.pdf" download target="_blank" rel="noopener noreferrer" class="bg-transparent hover:bg-[var(--text-color)]/10 text-[var(--text-color)] font-semibold px-8 py-3 rounded-lg text-center transition-all duration-300 border border-[var(--text-color)]/30">
        Descargar CV
      </a>
    </div>

    <div class="border-t border-[var(--text-color)]/20 pt-16">
      <h2 class="animate-on-scroll text-2xl font-bold mb-4 opacity-100">Sobre mí</h2>
      <p class="animate-on-scroll text-lg leading-relaxed opacity-80">
        Estudiante de Ingeniería de Software, con experiencia trabajando en proyectos reales de desarrollo web y análisis de datos. Me interesa construir software que resuelva problemas concretos, con atención tanto al código como a la experiencia de quien lo usa.
      </p>
    </div>

    <div class="border-t border-[var(--text-color)]/20 pt-16 mt-16">
      <h2 class="animate-on-scroll text-2xl font-bold mb-8 opacity-100">Stack técnico</h2>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <!-- Bento Card: Frontend -->
        <div class="animate-on-scroll p-6 rounded-2xl border border-[var(--text-color)]/10 bg-[var(--text-color)]/[0.02] hover:border-[var(--accent-color)]/40 hover:bg-[var(--text-color)]/[0.04] transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-2 mb-4">
              <span class="w-2 h-2 rounded-full bg-blue-500"></span>
              <h3 class="text-base font-semibold tracking-wide opacity-95">Frontend</h3>
            </div>
            <div class="flex flex-wrap gap-2.5">
              <SkillBadge name="HTML" colored />
              <SkillBadge name="CSS" colored />
              <SkillBadge name="Tailwind CSS" colored />
              <SkillBadge name="JavaScript" colored />
              <SkillBadge name="TypeScript" colored />
              <SkillBadge name="React" colored />
            </div>
          </div>
        </div>

        <!-- Bento Card: Backend -->
        <div class="animate-on-scroll p-6 rounded-2xl border border-[var(--text-color)]/10 bg-[var(--text-color)]/[0.02] hover:border-[var(--accent-color)]/40 hover:bg-[var(--text-color)]/[0.04] transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-2 mb-4">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              <h3 class="text-base font-semibold tracking-wide opacity-95">Backend</h3>
            </div>
            <div class="flex flex-wrap gap-2.5">
              <SkillBadge name="Node.js" colored />
              <SkillBadge name="Express" colored />
              <SkillBadge name="Spring Boot" colored />
              <SkillBadge name="FastAPI" colored />
              <SkillBadge name="PHP" colored />
            </div>
          </div>
        </div>

        <!-- Bento Card: Bases de datos -->
        <div class="animate-on-scroll p-6 rounded-2xl border border-[var(--text-color)]/10 bg-[var(--text-color)]/[0.02] hover:border-[var(--accent-color)]/40 hover:bg-[var(--text-color)]/[0.04] transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-2 mb-4">
              <span class="w-2 h-2 rounded-full bg-amber-500"></span>
              <h3 class="text-base font-semibold tracking-wide opacity-95">Bases de datos</h3>
            </div>
            <div class="flex flex-wrap gap-2.5">
              <SkillBadge name="PostgreSQL" colored />
              <SkillBadge name="MySQL" colored />
              <SkillBadge name="MariaDB" colored />
              <SkillBadge name="NoSQL" colored />
            </div>
          </div>
        </div>

        <!-- Bento Card: DevOps y herramientas -->
        <div class="animate-on-scroll p-6 rounded-2xl border border-[var(--text-color)]/10 bg-[var(--text-color)]/[0.02] hover:border-[var(--accent-color)]/40 hover:bg-[var(--text-color)]/[0.04] transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-2 mb-4">
              <span class="w-2 h-2 rounded-full bg-purple-500"></span>
              <h3 class="text-base font-semibold tracking-wide opacity-95">DevOps y herramientas</h3>
            </div>
            <div class="flex flex-wrap gap-2.5">
              <SkillBadge name="Docker" colored />
              <SkillBadge name="Git" colored />
              <SkillBadge name="GitHub" colored />
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="border-t border-[var(--text-color)]/20 pt-16 mt-16">
      <h2 class="animate-on-scroll text-2xl font-bold mb-12 opacity-100 text-center md:text-left">Experiencia</h2>
      
      <!-- Contenedor del Timeline Zigzag -->
      <div class="relative max-w-5xl mx-auto">
        <!-- Línea Vertical Central (Desktop) / Izquierda (Mobile) -->
        <div class="absolute left-[19px] md:left-1/2 md:-ml-[1px] top-4 bottom-4 w-0.5 bg-gradient-to-b from-[var(--text-color)]/0 via-[var(--text-color)]/20 to-[var(--text-color)]/0"></div>

        <div class="flex flex-col relative z-10">
          <ExperienceItem 
            role="Desarrollador de Software"
            company="ASESCON"
            period="Febrero 2026 – Actualidad"
            description="Desarrollo de sistema web para procesamiento y análisis de datos contables. Manejo de archivos Excel con grandes volúmenes de información, generación de reportes y estadísticas, implementación de funcionalidades de filtrado, almacenamiento y descarga de datos."
            stack={['React', 'FastAPI']}
            isCurrent={true}
            align="left"
          />
          <ExperienceItem 
            role="Asistente de Sistemas"
            company="CompuServic"
            period="Julio 2025 – Diciembre 2025"
            description="Participación en diseño y mantenimiento de páginas web y sistemas internos, organización y actualización de contenido digital, gestión de datos y reportes estadísticos, soporte técnico y mantenimiento preventivo de equipos."
            align="right"
          />
        </div>
      </div>
    </div>

    <!-- SECCIÓN: PROYECTOS DESTACADOS -->
    <div class="border-t border-[var(--text-color)]/20 pt-16 mt-16">
      <h2 class="animate-on-scroll text-2xl font-bold mb-8 opacity-100">Proyectos destacados</h2>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 mb-12">
        {featuredProjects.map(project => (
          <ProjectCard project={project} />
        ))}
      </div>
      
      <div class="animate-on-scroll text-center md:text-left">
        <a href="/proyectos" class="inline-flex items-center gap-2 text-[var(--accent-color)] font-semibold hover:opacity-80 transition-opacity duration-300 text-lg">
          Ver todos los proyectos 
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>

    <!-- SECCIÓN: CONTACTO -->
    <ContactSection />
  </section>
  </div>
</Layout>
