---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);

const seriousProjects = sortedProjects.filter(p => p.data.tier === 'serio');
const academicProjects = sortedProjects.filter(p => p.data.tier === 'academico');
---

<Layout title="Proyectos | Portafolio Isaac Paucar">
  <div class="max-w-4xl mx-auto pt-10 pb-20">
    <header class="mb-16">
      <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-4 text-[var(--text-color)]">Proyectos</h1>
      <p class="text-xl text-[var(--text-color)] opacity-80 max-w-2xl">
        Una colección de sistemas, aplicaciones y experimentos en los que he trabajado, desde proyectos empresariales hasta académicos.
      </p>
    </header>

    <!-- Proyectos Principales -->
    {seriousProjects.length > 0 && (
      <section class="mb-20">
        <h2 class="text-2xl font-bold mb-8 text-[var(--text-color)] border-b border-[var(--text-color)]/20 pb-4">Sistemas Destacados</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
          {seriousProjects.map(project => (
            <ProjectCard project={project} />
          ))}
        </div>
      </section>
    )}

    <!-- Proyectos Académicos -->
    {academicProjects.length > 0 && (
      <section class="mb-20">
        <h2 class="text-2xl font-bold mb-8 text-[var(--text-color)] border-b border-[var(--text-color)]/20 pb-4">Proyectos Académicos y Experimentos</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {academicProjects.map(project => (
            <ProjectCard project={project} />
          ))}
        </div>
      </section>
    )}

    <!-- CTA de cierre -->
    <section class="mt-24 pt-12 border-t border-[var(--text-color)]/20 text-center">
      <h3 class="text-2xl font-bold mb-4">¿Quieres ver más código?</h3>
      <p class="text-lg opacity-80 mb-8 max-w-xl mx-auto">
        Todo el código fuente público, configuraciones y proyectos en curso están disponibles en mi perfil de GitHub.
      </p>
      <a 
        href="https://github.com/Isaac-9026" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-[var(--text-color)] text-[var(--bg-color)] hover:opacity-90 font-bold rounded-lg transition-opacity"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.02c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A4.8 4.8 0 0 0 8 18v4"></path>
        </svg>
        Visitar mi GitHub
      </a>
    </section>
  </div>
</Layout>
