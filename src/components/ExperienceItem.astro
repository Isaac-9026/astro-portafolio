---
import SkillBadge from './SkillBadge.astro';

interface Props {
  role: string;
  company: string;
  period: string;
  description: string;
  stack?: string[];
  isCurrent?: boolean;
}

const { role, company, period, description, stack, isCurrent = false } = Astro.props;
---

<li class="mb-12 ms-4 sm:ms-6 relative group">
  <!-- Punto del timeline -->
  <span class:list={[
    "absolute flex items-center justify-center w-3 h-3 rounded-full -start-[1.4rem] sm:-start-[1.9rem] ring-4 ring-[var(--bg-color)] top-8 transition-colors duration-300",
    isCurrent ? "bg-[var(--accent-color)]" : "bg-[var(--text-color)]/30 group-hover:bg-[var(--accent-color)]/70"
  ]}></span>
  
  <!-- Contenido en Card -->
  <div class="flex flex-col p-6 sm:p-8 rounded-xl border border-[var(--text-color)]/20 bg-[var(--text-color)]/5 hover:shadow-[0_8px_30px_var(--shadow-accent)] hover:bg-[var(--text-color)]/10 hover:border-[var(--accent-color)]/50 transition-all duration-300">
    <h3 class="text-xl font-bold opacity-100">{role}</h3>
    <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4 mb-4 mt-2">
      <span class="text-lg font-medium text-[var(--accent-color)] opacity-100">{company}</span>
      <span class="hidden sm:block opacity-30">|</span>
      <time class="font-mono text-sm font-medium opacity-70 uppercase tracking-wider">{period}</time>
    </div>
    
    <p class="text-lg opacity-90 leading-relaxed mb-4">
      {description}
    </p>
    
    <!-- Badges -->
    {stack && stack.length > 0 && (
      <div class="flex flex-wrap gap-2 mt-2">
        {stack.map((tech) => (
          <SkillBadge name={tech} />
        ))}
      </div>
    )}
  </div>
</li>
