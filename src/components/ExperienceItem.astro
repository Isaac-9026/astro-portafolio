---
import SkillBadge from './SkillBadge.astro';

interface Props {
  role: string;
  company: string;
  period: string;
  description: string;
  stack?: string[];
  isCurrent?: boolean;
}

const { role, company, period, description, stack, isCurrent = false } = Astro.props;
---

<li class="mb-10 ms-6 last:mb-0">
  <!-- El punto del timeline -->
  <span class:list={[
    "absolute flex items-center justify-center w-3 h-3 rounded-full -start-1.5 ring-4 ring-[var(--bg-color)] mt-1.5",
    isCurrent ? "bg-[var(--accent-color)]" : "bg-[var(--text-color)]/30"
  ]}></span>
  
  <!-- Contenido -->
  <h3 class="text-xl font-bold opacity-100">{role}</h3>
  <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4 mb-3">
    <span class="text-lg font-medium text-[var(--accent-color)] opacity-90">{company}</span>
    <span class="hidden sm:block opacity-30">|</span>
    <time class="font-mono text-sm font-medium opacity-60 uppercase tracking-wider">{period}</time>
  </div>
  
  <p class="text-lg opacity-80 leading-relaxed mb-4">
    {description}
  </p>
  
  <!-- Badges -->
  {stack && stack.length > 0 && (
    <div class="flex flex-wrap gap-2 mt-4">
      {stack.map((tech) => (
        <SkillBadge name={tech} />
      ))}
    </div>
  )}
</li>
