---
import SkillBadge from './SkillBadge.astro';

interface Props {
  role: string;
  company: string;
  period: string;
  description: string;
  stack?: string[];
  isCurrent?: boolean;
  align?: 'left' | 'right';
}

const { role, company, period, description, stack, isCurrent = false, align = 'right' } = Astro.props;

// Si align es 'left', la tarjeta va a la izquierda de la línea central (en desktop)
const isLeft = align === 'left';
---

<div class={`animate-on-scroll relative flex w-full flex-col md:flex-row ${isLeft ? 'md:flex-row-reverse' : ''} group mb-8 md:mb-10 last:mb-0`}>
  
  <!-- Spacer invisible para mantener el equilibrio en grid flex de desktop -->
  <div class="hidden md:block md:w-1/2"></div>

  <!-- Nodo Central (Timeline Marker) -->
  <div class="absolute left-0 md:left-1/2 md:-translate-x-1/2 flex items-center justify-center w-8 h-8 rounded-full border-[3px] border-[var(--bg-color)] bg-[var(--text-color)]/10 group-hover:bg-[var(--text-color)]/20 transition-colors z-10 top-0 md:top-6">
    <div class:list={[
      "w-2.5 h-2.5 rounded-full transition-all duration-300 relative",
      isCurrent ? "bg-[var(--accent-color)] shadow-[0_0_8px_var(--accent-color)]" : "bg-[var(--text-color)]/40 group-hover:bg-[var(--accent-color)]"
    ]}>
      {isCurrent && <div class="absolute inset-0 w-full h-full rounded-full bg-[var(--accent-color)] animate-ping opacity-75"></div>}
    </div>
  </div>

  <!-- Contenedor de la Tarjeta -->
  <div class={`w-full pl-12 md:w-1/2 md:pl-0 ${isLeft ? 'md:pr-10' : 'md:pl-10'}`}>
    
    <div class="p-5 sm:p-6 rounded-xl border border-[var(--text-color)]/10 bg-[var(--text-color)]/[0.02] hover:border-[var(--accent-color)]/40 hover:bg-[var(--text-color)]/[0.04] transition-all duration-300 hover:shadow-[0_4px_20px_var(--shadow-accent)] hover:-translate-y-1">
      
      <div class="flex flex-col mb-3 text-left">
        <time class="font-mono text-xs font-semibold opacity-80 uppercase tracking-wider mb-1 text-[var(--accent-color)]">{period}</time>
        <h3 class="text-xl font-bold opacity-100 mb-0.5">{role}</h3>
        <span class="text-base font-medium opacity-80">{company}</span>
      </div>
      
      <p class="text-sm sm:text-base opacity-80 leading-relaxed mb-4 text-left">
        {description}
      </p>
      
      <!-- Badges de Tecnologías -->
      {stack && stack.length > 0 && (
        <div class="flex flex-wrap gap-1.5 justify-start">
          {stack.map((tech) => (
            <SkillBadge name={tech} colored />
          ))}
        </div>
      )}

    </div>
  </div>
</div>
